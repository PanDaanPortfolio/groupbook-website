# ══════════════════════════════════════════════════════════════════════════════
# Booyco HVAC Service Register — Environment Variables
# Copy to .env and fill in real values
# ══════════════════════════════════════════════════════════════════════════════

# Supabase — get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Anthropic Claude API — for AI scan feature
# NOTE: In production, this should be called via a Supabase Edge Function
# to avoid exposing the API key in the browser. See /supabase/functions/scan-report/
VITE_ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
